@article{martin-butragueno_approach_2020,
	title = {An approach to subject pronoun expression patterns in data from the “{Project} for the {Sociolinguistic} {Study} of {Spanish} in {Spain} and {America}”},
	volume = {17},
	copyright = {https://benjamins.com/content/customers/rights},
	issn = {1571-0718, 1571-0726},
	url = {http://www.jbe-platform.com/content/journals/10.1075/sic.00060.mar},
	doi = {10.1075/sic.00060.mar},
	abstract = {The objective of this article is to extract certain general consequences about social and linguistic-pragmatic conditions in the expression of subject personal pronouns (SPPs) in contemporary urban Spanish. The study examines some of the results obtained in Valencia and Granada, Spain; Mexico City, Mexico; San Juan, Puerto Rico; Caracas, Venezuela; Bogotá and Medellín, Colombia; and Montevideo, Uruguay. These works have all analyzed data from the “Project for the Sociolinguistic Study of Spanish in Spain and America” (PRESEEA), thus they all share data collected under very similar circumstances (Moreno Fernández 1996; Cestero Mancera 2012). The presence or the absence of pronominal subjects in Spanish is required in certain contexts, but in most cases they are considered optional. This optionality depends on fixed factors of linguistic nature (such as the grammatical person and number of the subject, or the coreference between the subject and a previous element) and of social nature (such as age or gender), and on random factors (such as individuals and verbal pieces). The hypotheses to be tested are: (a) there is geographical variation among the cities studied, which is reflected in the rates of overt SPPs (Otheguy \& Zentella 2012; Carvalho, Orozco \& Shin 2015); (b) social variation is relatively small within each city; (c) the fixed and random linguistic-pragmatic variation is intense within each city and similar among cities; (d) the most relevant factors that activate overt SPPs are related to adequate information management of the anaphoric chains and textual coherence.},
	language = {en},
	number = {2},
	urldate = {2026-03-07},
	journal = {Spanish in Context},
	author = {Martín-Butragueño, Pedro},
	month = oct,
	year = {2020},
